# ─── Database (Postgres — Neon in prod, local Postgres in dev) ────────────────
DATABASE_URL="postgresql://user:pass@localhost:5432/mirrorpip?schema=public"
# Direct (non-pooled) URL for migrations when using a pooled DATABASE_URL (Neon).
DIRECT_URL="postgresql://user:pass@localhost:5432/mirrorpip?schema=public"

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
# 32+ char random secret. Generate: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-in-production-please"
# Public base URL of the web app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Google OAuth is hidden unless this is exactly "true". Register this callback:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Secret vault (exchange API keys are AES-256-GCM encrypted at rest) ────────
# EXACTLY 32 bytes, base64-encoded. Generate: openssl rand -base64 32
# The web app (encrypt on connect) and engine (decrypt to trade) MUST share this.
CREDENTIAL_ENCRYPTION_KEY="Z2VuZXJhdGUtYS0zMi1ieXRlLWtleS1oZXJlLXBscw=="

# ─── Delta Exchange India ─────────────────────────────────────────────────────
# Production India endpoints. For safe testing, point these at the testnet:
#   REST  https://cdn-ind.testnet.deltaex.org
#   WS    wss://socket-ind.testnet.deltaex.org
DELTA_REST_URL="https://api.india.delta.exchange"
DELTA_WS_URL="wss://socket.india.delta.exchange"

# New venues can verify/read accounts immediately. Real orders stay off until
# a controlled minimum-size live canary has passed for that venue.
PI42_REST_URL="https://fapi.pi42.com"
PI42_WS_URL="https://fawss-uds.pi42.com/auth-stream"
PI42_ORDERS_ENABLED="false"
SHARK_REST_URL="https://api.sharkexchange.in"
SHARK_WS_URL="https://fawss-uds.sharkexchange.in/auth-stream"
SHARK_ORDERS_ENABLED="false"
MUDREX_REST_URL="https://trade.mudrex.com/fapi/v1"
MUDREX_ORDERS_ENABLED="false"
LIVE_EXCHANGE_CANARY="0"

# ─── Copy engine ──────────────────────────────────────────────────────────────
# How often the engine reconciles config (leaders/follows) from the DB, in ms.
ENGINE_SYNC_INTERVAL_MS="5000"
# How often the engine reconciles follower positions vs leaders, in ms.
ENGINE_RECONCILE_INTERVAL_MS="30000"

# ─── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated emails granted admin (leader verification, kill-switch).
ADMIN_EMAILS="you@example.com"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# OTP verification + password reset emails. Without a key, codes are printed
# to the web server console (dev only). Get a key at https://resend.com
RESEND_API_KEY=""
RESEND_FROM="MirrorPip <onboarding@resend.dev>"
