// MirrorPip-X schema — PostgreSQL (Neon in prod).
// Auth tables (user/session/account/verification) are better-auth managed.
// App tables key by userId (String) and never FK into `user`, so auth can be
// swapped without a migration cascade.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (better-auth managed) ───────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // "user" | "admin". Admins verify leaders and hold the kill-switch.
  role          String   @default("user")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Profile fields collected at signup (better-auth additionalFields).
  country    String?
  city       String?
  postalCode String?
  phone      String?
  // Declared intent at signup: "follower" | "leader".
  intendedRole String?
  referralCode String?
  // Consent stamps — recorded at signup, needed for compliance.
  tosAcceptedAt            DateTime?
  riskDisclosureAcceptedAt DateTime?
  // Geocoded async after signup (best-effort, for the admin geo view).
  lat               Float?
  lng               Float?
  locationUpdatedAt DateTime?

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Exchange {
  DELTA_INDIA
  SHARK
  PI42
  MUDREX
  BYBIT // reserved for a later adapter
}

enum CredentialStatus {
  ACTIVE
  INVALID
  REVOKED
}

enum LeaderStatus {
  PENDING // registered, awaiting admin verification
  VERIFIED // live and followable
  PAUSED // temporarily not copying
  DELISTED // hidden from the leaderboard
}

enum FollowStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum SizingMode {
  PROPORTIONAL // scale by (follower equity / leader equity) * sizingValue
  FIXED_MARGIN // spend a fixed margin (sizingValue, in USD) per leader entry
  MULTIPLIER // copy leader qty * sizingValue
}

enum OrderSide {
  BUY
  SELL
}

enum CopyOrderStatus {
  PENDING
  SUBMITTED
  FILLED
  PARTIAL
  REJECTED
  SKIPPED // risk limit / kill-switch / sizing rounded to zero
}

enum PositionSide {
  LONG
  SHORT
}

// ─── Exchange credentials (encrypted API keys) ─────────────────────────────────

model ExchangeCredential {
  id       String   @id @default(cuid())
  userId   String
  exchange Exchange @default(DELTA_INDIA)
  label    String   @default("My account")

  // AES-256-GCM ciphertext (iv:tag:data, base64). NEVER returned to the client.
  apiKeyEnc    String
  apiSecretEnc String
  // Last 4 chars of the public API key — safe to show for identification.
  keyLast4 String
  // Stable keyed digest used only to prevent connecting one exchange account twice.
  apiKeyFingerprint String?

  baseCurrency String           @default("USD")
  tradeCurrency String          @default("USDT")
  settings      Json            @default("{}")
  status       CredentialStatus @default(ACTIVE)
  verifiedAt   DateTime?
  lastCheckedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaderProfile Leader?  @relation("LeaderCredential")
  follows       Follow[] @relation("FollowerCredential")

  @@index([userId])
  @@unique([exchange, apiKeyFingerprint])
  @@map("exchange_credential")
}

// ─── Leaders (publicly followable traders) ─────────────────────────────────────

model Leader {
  id     String @id @default(cuid())
  userId String

  // The account we watch for this leader's fills.
  credentialId String             @unique
  credential   ExchangeCredential @relation("LeaderCredential", fields: [credentialId], references: [id], onDelete: Cascade)

  exchange    Exchange     @default(DELTA_INDIA)
  displayName String
  bio         String?
  avatarUrl   String?
  status      LeaderStatus @default(PENDING)

  // Optional caps / economics.
  maxFollowers Int?
  feeBps       Int          @default(0) // performance fee in basis points (future billing)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stats        LeaderStat[]
  follows      Follow[]
  fills        LeaderFill[]
  equityPoints LeaderEquityPoint[]

  @@index([status])
  @@map("leader")
}

// Time series of a leader's account equity — the source for ROI + drawdown.
model LeaderEquityPoint {
  id       String @id @default(cuid())
  leaderId String
  leader   Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  equityUsd Decimal  @db.Decimal(20, 2)
  ts        DateTime @default(now())

  @@index([leaderId, ts])
  @@map("leader_equity_point")
}

// Rolling performance snapshot, recomputed by the engine.
model LeaderStat {
  id       String @id @default(cuid())
  leaderId String
  leader   Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  window         String // "7d" | "30d" | "all"
  roiPct         Decimal @default(0) @db.Decimal(12, 4)
  winRatePct     Decimal @default(0) @db.Decimal(6, 2)
  maxDrawdownPct Decimal @default(0) @db.Decimal(6, 2)
  totalCopiedUsd Decimal @default(0) @db.Decimal(20, 2)
  tradeCount     Int     @default(0)
  followerCount  Int     @default(0)

  updatedAt DateTime @updatedAt

  @@unique([leaderId, window])
  @@map("leader_stat")
}

// ─── Follows (a follower's subscription to a leader) ───────────────────────────

model Follow {
  id             String @id @default(cuid())
  followerUserId String

  leaderId String
  leader   Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  credentialId String
  credential   ExchangeCredential @relation("FollowerCredential", fields: [credentialId], references: [id], onDelete: Cascade)

  sizingMode  SizingMode @default(PROPORTIONAL)
  sizingValue Decimal    @default(1) @db.Decimal(20, 8)

  maxPositionUsd   Decimal? @db.Decimal(20, 2)
  dailyLossLimitUsd Decimal? @db.Decimal(20, 2)
  copyReverse      Boolean  @default(false)

  status    FollowStatus @default(ACTIVE)
  startedAt DateTime     @default(now())
  pausedAt  DateTime?
  stoppedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copyOrders    CopyOrder[]
  copyPositions CopyPosition[]

  @@unique([followerUserId, leaderId])
  @@index([leaderId, status])
  @@index([followerUserId])
  @@map("follow")
}

// ─── Leader fills (normalized WS events — source of truth for fan-out) ─────────

model LeaderFill {
  id       String @id @default(cuid())
  leaderId String
  leader   Leader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  exchange Exchange @default(DELTA_INDIA)
  // Exchange-native fill id, for idempotent ingestion.
  externalId String
  symbol     String
  side       OrderSide
  qty        Decimal   @db.Decimal(30, 10)
  price      Decimal   @db.Decimal(30, 10) // USD when priceUsd set, otherwise native
  quoteCurrency String? // venue quote currency of `price` (e.g. INR) — null = USD/unknown
  nativePrice  Decimal? @db.Decimal(30, 10)
  priceUsd     Decimal? @db.Decimal(30, 10)
  reduceOnly Boolean   @default(false)
  leaderPositionKey String? // symbol/position grouping key from the exchange

  exchTs     DateTime
  ingestedAt DateTime @default(now())

  copyOrders CopyOrder[]

  @@unique([leaderId, externalId])
  @@index([leaderId, exchTs])
  @@map("leader_fill")
}

// ─── Copy orders (one replicated order per follow per leader fill) ─────────────

model CopyOrder {
  id       String @id @default(cuid())
  followId String
  follow   Follow @relation(fields: [followId], references: [id], onDelete: Cascade)

  leaderFillId String
  leaderFill   LeaderFill @relation(fields: [leaderFillId], references: [id], onDelete: Cascade)

  exchange Exchange @default(DELTA_INDIA)
  // Deterministic idempotency key: never place the same copy twice on retry.
  clientOrderId String @unique

  symbol      String
  side        OrderSide
  qty         Decimal         @db.Decimal(30, 10)
  status      CopyOrderStatus @default(PENDING)
  filledQty   Decimal         @default(0) @db.Decimal(30, 10)
  avgPrice    Decimal?        @db.Decimal(30, 10)
  exchOrderId String?
  slippageBps Decimal?        @db.Decimal(12, 4)
  // Exchange-reported costs in the order's quote currency.
  commission Decimal? @db.Decimal(20, 8)
  fees       Decimal? @db.Decimal(20, 8)
  error      String?

  requestedAt DateTime  @default(now())
  filledAt    DateTime?

  @@index([followId, requestedAt])
  @@index([leaderFillId])
  @@map("copy_order")
}

// ─── Copy positions (reconciled open/closed positions per follow) ──────────────

model CopyPosition {
  id       String @id @default(cuid())
  followId String
  follow   Follow @relation(fields: [followId], references: [id], onDelete: Cascade)

  symbol        String
  side          PositionSide
  qty           Decimal      @db.Decimal(30, 10)
  avgEntry      Decimal      @db.Decimal(30, 10)
  markPrice     Decimal?     @db.Decimal(30, 10)
  unrealizedPnl Decimal      @default(0) @db.Decimal(20, 2)
  realizedPnl   Decimal      @default(0) @db.Decimal(20, 2)

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([followId, symbol])
  @@index([followId])
  @@map("copy_position")
}

// ─── Product usage tracking (drives the admin engagement view) ──────────────

// One row per continuous visit per browser tab; reopened when the last
// heartbeat is <30min old. clientId is a per-tab UUID from the tracker.
model UsageSession {
  id       String  @id @default(cuid())
  userId   String
  clientId String?

  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int       @default(0)
  pagePath    String?
  userAgent   String?

  @@index([userId, lastSeenAt])
  @@index([userId, clientId])
  @@map("usage_session")
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  type      String // "page_view" | "heartbeat" | "session_end"
  path      String?
  feature   String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@map("usage_event")
}

// ─── Admin audit trail (who did what, when) ──────────────────────────────────

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "leader.verified", "kill_switch.enabled", "grant.created"
  actorId    String
  actorEmail String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_log")
}

// ─── In-app notifications ────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // e.g. "credential.invalid", "leader.verified", "copy_order.rejected"
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

// ─── Access grants (invite/beta gating when beta_mode setting is on) ──────────

model AccessGrant {
  id            String    @id @default(cuid())
  email         String
  note          String    @default("")
  grantedBy     String
  grantedByEmail String
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([email])
  @@map("access_grant")
}

// ─── System settings (kill-switch, engine flags) ──────────────────────────────

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_setting")
}
